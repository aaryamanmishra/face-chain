# .env.example — copy to .env and fill in your values.
# face-chain will automatically load this file via python-dotenv.

# ── Required ──────────────────────────────────────────────────────────────
# Your SerpAPI key. Get one at https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# ── Optional ──────────────────────────────────────────────────────────────
# Python logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Ethereum (Sepolia Testnet) ─────────────────────────────────────────────
# Generate a test wallet with:
#   node -e "const {ethers}=require('ethers'); const w=ethers.Wallet.createRandom(); console.log(w.address, w.privateKey)"
# WARNING: Use a dedicated TEST wallet only. Never fund with real ETH.
WALLET_ADDRESS=0xYourWalletAddress
PRIVATE_KEY=0xYourPrivateKey
# Free public Sepolia RPC — or use Alchemy/Infura for higher rate limits:
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
