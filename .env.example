# .env.example — copy to .env and fill in your values.
# face-chain will automatically load this file via python-dotenv.

# ── Required ──────────────────────────────────────────────────────────────
# Your SerpAPI key. Get one at https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# ── Optional ──────────────────────────────────────────────────────────────
# Python logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
